generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Define Roles for your SaaS
enum Role {
  ADMIN
  TENANT
}

// 2. Define Supported AI Providers
enum LLMProvider {
  QWEN
  OPENAI
  ANTHROPIC
  CUSTOM
}

// 3. The User Model (For Login & Admin)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // We will hash this with bcrypt in Phase 2
  role      Role     @default(TENANT)
  createdAt DateTime @default(now())

  tenants   Tenant[]
}

// 4. The Upgraded Tenant Model
model Tenant {
  id             String      @id @default(cuid())
  businessName   String
  whatsappNumber String      @unique
  websiteUrl     String?     // 🚨 NEW: Store the website URL
  
  // 🌟 NEW: Business Context for Tailored AI Responses
  // This tells the AI exactly what the business does so it doesn't hallucinate.
  systemPrompt   String      @default("You are a helpful AI assistant.")
  businessContext String?    @db.Text
  contactInfo    String?     @db.Text 
 

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  // 🧠 NEW: Bring Your Own LLM (BYOK) Fields
 llmProvider    String?     // e.g., "OPENAI", "QWEN", "CUSTOM"
  llmApiKey      String?     
  llmModel       String?     // Dynamically selected best model
  llmBaseUrl     String?     // API Base URL (auto-detected or custom)

  // 🔗 Relations
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
}

// 5. The Message Model
model Message {
  id        String   @id @default(cuid())
  fromNumber String
  toNumber   String
  direction  String   // 'inbound' or 'outbound'
  content    String   @db.Text
  isAiReply  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}