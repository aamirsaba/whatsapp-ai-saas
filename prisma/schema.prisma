generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Define Roles for your SaaS
enum Role {
  ADMIN
  TENANT
  AGENT // 🚨 ADDED: So invited team members get the correct role
}

// 2. Define Supported AI Providers
enum LLMProvider {
  QWEN
  OPENAI
  ANTHROPIC
  CUSTOM
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

// 3. The User Model (For Login & Admin)
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  role            Role           @default(TENANT)
  isAgency        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  tenants         Tenant[]
  teamMemberships TeamMember[]
}

// 4. The Upgraded Tenant Model
model Tenant {
  id               String         @id @default(cuid())
  businessName     String
  whatsappNumber   String         @unique
  websiteUrl       String?
  
  isSummaryEnabled Boolean        @default(false)
  summaryTime      String?

  systemPrompt     String         @default("You are a helpful AI assistant.")
  businessContext  String?        @db.Text
  contactInfo      String?        @db.Text
  serviceAreas     String?        @db.Text 

  isActive         Boolean        @default(true)
  isHumanMode      Boolean        @default(false)
  createdAt        DateTime       @default(now())

  llmProvider      String?
  llmApiKey        String?
  llmModel         String?
  llmBaseUrl       String?
  leadWebhookUrl   String?
  botPolicy        String?        @db.Text // Stores custom rules/policy (optional for future use)
  knowledgeBase    String?        @db.Text // 🚨 NEW: Stores extracted text from uploaded PDFs

  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages         Message[]
  leads            Lead[]
  teamMembers      TeamMember[]
  invitations      TeamInvitation[] // 🚨 ADDED: Relation to invitations
}

// 5. The Message Model
model Message {
  id         String   @id @default(cuid())
  fromNumber String
  toNumber   String
  direction  String
  content    String   @db.Text
  isAiReply  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 6. The Lead Model (CRM)
model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber  String
  firstMessage String     @db.Text
  status       LeadStatus @default(NEW)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// 7. The Team Member Model (Shared Inbox)
model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("AGENT") 
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
}

// 8. 🚨 NEW: The Team Invitation Model
model TeamInvitation {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}