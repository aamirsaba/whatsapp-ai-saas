generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Define Roles for your SaaS
enum Role {
  ADMIN
  TENANT
  AGENT
}

// 2. Define Supported AI Providers
enum LLMProvider {
  QWEN
  OPENAI
  ANTHROPIC
  CUSTOM
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

// 3. The User Model (For Login & Admin)
model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  role                   Role     @default(TENANT)
  isAgency               Boolean  @default(false)
  createdAt              DateTime @default(now())
  requiresPasswordChange Boolean  @default(false) 
  
  tenants                Tenant[]
  teamMemberships        TeamMember[]
}

// 4. The Upgraded Tenant Model (with Token Wallet & Billing)
model Tenant {
  id                     String         @id @default(cuid())
  businessName           String
  whatsappNumber         String         @unique
  websiteUrl             String?
  botType                String         @default("business") 
  isSummaryEnabled       Boolean        @default(false)
  summaryTime            String?
  systemPrompt           String         @default("You are a helpful AI assistant.")
  businessContext        String?        @db.Text
  contactInfo            String?        @db.Text
  serviceAreas           String?        @db.Text 
  isActive               Boolean        @default(true)
  isHumanMode            Boolean        @default(false)
  createdAt              DateTime       @default(now())
  llmProvider            String?
  llmApiKey              String?
  llmModel               String?
  llmBaseUrl             String?
  leadWebhookUrl         String?
  botPolicy              String?        @db.Text 
  knowledgeBase          String?        @db.Text 
  userId                 String?
  user                   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages               Message[]
  leads                  Lead[]
  teamMembers            TeamMember[]
  invitations            TeamInvitation[] 
  knowledgeDocuments     KnowledgeDocument[]
  agents                 Agent[]
  conversations          Conversation[]
  aiAgentName            String?  

  // 🚨 BILLING FIELDS (Inside the model!)
  plan                   String         @default("trial")
  tokenBalance           Int            @default(0)
  tokenLimit             Int            @default(0)
  isSuspended            Boolean        @default(false)

  // 🚨 RELATION TO ALERTS
  alerts                 Alert[]
}

// 5. The Message Model
model Message {
  id         String   @id @default(cuid())
  fromNumber String
  toNumber   String
  direction  String
  content    String   @db.Text
  isAiReply  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 6. The Lead Model (CRM)
model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber  String
  firstMessage String     @db.Text
  status       LeadStatus @default(NEW)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// 7. The Team Member Model (Shared Inbox)
model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("AGENT") 
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
}

// 8. The Team Invitation Model
model TeamInvitation {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  fileName    String
  fileSize    Int
  content     String   @db.Text
  createdAt   DateTime @default(now())
}

// 👨‍💼 AGENT MANAGEMENT
model Agent {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  email             String
  whatsappNumber    String?
  languages         String   @default("[]") 
  preferredLanguage String   @default("English")
  isAvailable       Boolean  @default(true)
  isBusy            Boolean  @default(false) 
  avatar            String?  
  createdAt         DateTime @default(now())
  
  conversations     Conversation[]
  statusLogs        AgentStatusLog[]
  
  @@unique([tenantId, email])
}

model AgentStatusLog {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status    String
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?
  
  @@index([agentId])
  @@index([startTime])
}

// 💬 PER-USER CONVERSATION CONTROL
model Conversation {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userNumber      String
  mode            String   @default("AI")
  assignedAgentId String?
  assignedAgent   Agent?   @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@unique([tenantId, userNumber])
}

// 🚨 NEW: Alert Model for System Notifications
model Alert {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String   @db.Text
  isRead      Boolean  @default(false)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
}